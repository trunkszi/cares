include_guard(GLOBAL)
function(cares_create_libraries)
  find_package(uarch CONFIG REQUIRED)
  find_package(uring CONFIG REQUIRED)
  find_package(c-ares CONFIG REQUIRED)
  foreach(layer IN ITEMS error types record query_table channel resolver)
    add_library(cares_${layer} INTERFACE)
    add_library(cares::${layer} ALIAS cares_${layer})
    set_target_properties(cares_${layer} PROPERTIES EXPORT_NAME ${layer})
    target_compile_features(cares_${layer} INTERFACE cxx_std_26)
    target_include_directories(cares_${layer} INTERFACE "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include>" "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>")
    target_compile_options(cares_${layer} INTERFACE
      "$<$<AND:$<COMPILE_LANGUAGE:CXX>,$<CXX_COMPILER_ID:Clang>>:-freflection-latest;-stdlib=libc++>"
      "$<$<AND:$<COMPILE_LANGUAGE:CXX>,$<CXX_COMPILER_ID:GNU>>:-freflection>"
      "$<$<COMPILE_LANGUAGE:CXX>:-fno-exceptions;-fno-rtti>")
  endforeach()
  target_link_libraries(cares_error INTERFACE uring::error c-ares::cares)
  target_link_libraries(cares_types INTERFACE cares::error uarch::uarch uarch::primitives)
  target_link_libraries(cares_record INTERFACE cares::types)
  target_link_libraries(cares_query_table INTERFACE cares::record)
  target_link_libraries(cares_channel INTERFACE cares::record)
  target_link_libraries(cares_resolver INTERFACE cares::channel cares::query_table uring::uring)
  add_library(cares INTERFACE)
  add_library(cares::cares ALIAS cares)
  target_link_libraries(cares INTERFACE cares::resolver)
endfunction()
function(cares_configure_internal target)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "NO_SANITIZERS" "" "")
  target_link_libraries(${target} PRIVATE cares::cares)
  uarch_configure_runtime(${target})
  cares_enable_warnings(${target})
  if(NOT ARG_NO_SANITIZERS)
    cares_enable_sanitizers(${target})
  endif()
endfunction()
function(cares_add_test target)
  add_executable(${target} ${ARGN})
  cares_configure_internal(${target})
  add_test(NAME ${target} COMMAND ${target})
endfunction()
