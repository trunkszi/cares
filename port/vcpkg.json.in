{
  "name": "cares",
  "version-semver": "@VERSION@",
  "description": "C++26 header-first asynchronous DNS resolver. Configure with CMake >= 4.0 and the required dependency packages.",
  "homepage": "https://github.com/trunkszi/cares",
  "license": "MIT",
  "supports": "linux & x64",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "c-ares",
      "default-features": false
    },
    "uring",
    "uarch"
  ]
}
